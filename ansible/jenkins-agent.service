[Unit]
Description=TaskFlow Jenkins Docker Build Agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=jenkins
Group=jenkins
WorkingDirectory=/home/jenkins/agent

ExecStart=/usr/bin/java -jar /home/jenkins/agent/agent.jar -url http://172.31.0.154:8080/ -secret @/home/jenkins/agent/secret-file -name taskflow-docker-agent -webSocket -workDir /home/jenkins/agent

Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
